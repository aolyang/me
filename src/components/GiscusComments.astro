---
// giscus widget — self-hosted at giscus.aolyang.me, discussions stored in
// the aolyang/me repository. Mapping: specific term = contentId (note id or
// post commentId), so the dynamic /notes/:id and static /posts/:slug pages
// share ONE discussion thread per piece of content.
interface Props {
  term: string;
}
const { term } = Astro.props;
---

<section class="comments-section">
  <script
    src="https://giscus.aolyang.me/client.js"
    data-repo="aolyang/me"
    data-repo-id="R_kgDOUYEVxw"
    data-category="Announcements"
    data-category-id="DIC_kwDOUYEVx84DF4Z_"
    data-mapping="specific"
    data-term={term}
    data-strict="1"
    data-reactions-enabled="1"
    data-emit-metadata="0"
    data-input-position="top"
    data-theme="light"
    data-lang="zh-CN"
    data-loading="lazy"
    crossorigin="anonymous"
    async
  ></script>
</section>
