---
import Base from "../layouts/Base.astro";
import { mergedList } from "../lib/resolver";

// SSR home with true data: D1 published notes ∪ deployed static posts.
const entries = await mergedList();
const KIND_LABEL: Record<string, string> = { note: "note", post: "post" };
---

<Base>
  <section class="masthead">
    <h1>写给自己的笔记</h1>
    <p>code, notes & life</p>
  </section>

  <ul class="index-list">
    {
      entries.map((e) => (
        <li>
          <div class="index-item-title">
            <a href={e.href}>{e.title}</a>
          </div>
          <div class="index-item-meta">
            <time datetime={e.date}>{e.date.slice(0, 10)}</time>
            <span>·</span>
            <span class="chip">{KIND_LABEL[e.kind]}</span>
          </div>
        </li>
      ))
    }
  </ul>
</Base>
