---
// Login page: OAuth buttons (when provider secrets are configured server-side)
// + password fallback (when AUTH_PASSWORD is set).
import Base from "../layouts/Base.astro";
import Login from "../components/Login";
import { githubEnabled } from "../lib/oauth";

const next = Astro.url.searchParams.get("next") ?? "/editor/";
const oauth = githubEnabled();
---

<Base title="登录">
  <Login client:load next={next} oauthEnabled={oauth} />
</Base>
